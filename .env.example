# ===== ClassTrack — ตัวอย่างตัวแปรสภาพแวดล้อม =====
# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจริง (ห้าม commit .env.local)

# Supabase → Project Settings → Data API: Project URL (รูปแบบ https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase → Project Settings → API Keys: Secret key (ขึ้นต้น sb_secret_) หรือ service_role key (แบบเดิม)
# ⚠️ กุญแจนี้เปิดฐานข้อมูลได้ทั้งหมด ห้ามใส่ในโฟลเดอร์ public/ และห้ามส่งให้ใคร
SUPABASE_SECRET_KEY=

# ข้อความสุ่มยาวอย่างน้อย 32 ตัว ใช้เซ็น session cookie และรหัสเช็กชื่อ
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# LINE Developers Console → LINE MINI App channel → Basic settings: Channel ID (ตัวเลข)
LINE_CHANNEL_ID=

# LIFF ID (รูปแบบ 1234567890-AbCdEfGh) ต้องตรงกับค่าใน public/js/config.js
LIFF_ID=

# true = อนุญาต login จำลองด้วย ?mockUser=... เฉพาะบน localhost (ห้ามตั้งบน Vercel)
DEV_MOCK_LOGIN=true
